PORT=4000
NODE_ENV=development

# Use a Supabase Session Pooler connection string in production.
# Keep this only in backend/.env locally or as a Render secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
DATABASE_SSL=false

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Classroom/demo tuning.
CRASH_GROWTH_RATE=0.06
